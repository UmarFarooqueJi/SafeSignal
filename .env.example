# SafeSignal Environment Variables - Copy to .env and fill
# NEVER commit .env to git!

# ─── Mesh API (Primary AI Backend) ───────────────────────
MESH_API_KEY=your_mesh_api_key_here

# ─── Supabase ────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ─── Google Safe Browsing ────────────────────────────────
SAFE_BROWSING_API_KEY=your_google_safe_browsing_key

# ─── VirusTotal ──────────────────────────────────────────
VIRUSTOTAL_API_KEY=your_virustotal_key

# ─── NewsData.io ─────────────────────────────────────────
NEWS_DATA_API_KEY=your_newsdata_key

# ─── AI Providers (Optional - at least one needed) ───────
OPENROUTER_API_KEY=your_openrouter_key
GROK_API_KEY=your_grok_key
DEEPSEEK_API_KEY=your_deepseek_key

# ─── Have I Been Pwned ───────────────────────────────────
HIBP_API_KEY=your_hibp_key

# ─── Environment ─────────────────────────────────────────
ENV=development
API_BASE_URL=http://10.0.2.2:8000
